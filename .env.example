# =============================================================================
# Variables de entorno
#
# Copia este archivo a .env.local y complétalo.
# Solo el bloque de Supabase es obligatorio: el resto de integraciones se
# activan cuando aparece su variable, y el sistema arranca y es navegable sin
# ninguna de ellas.
# =============================================================================

# -- Aplicación ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -- Supabase (OBLIGATORIO) ---------------------------------------------------
# Panel de Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Salta RLS. Solo se usa en webhooks y crons, que no tienen sesión de usuario.
# NUNCA debe llegar al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# -- Anthropic (asistente de IA) ----------------------------------------------
# Sin esto el asistente informa de que no está configurado; el resto funciona.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# -- WhatsApp Cloud API -------------------------------------------------------
# Meta for Developers → WhatsApp → API Setup.
# Sin esto los envíos se registran en consola en lugar de enviarse, lo que
# permite depurar los flujos completos sin una cuenta de Meta.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Cadena que tú eliges; debe coincidir con la del panel de Meta.
WHATSAPP_VERIFY_TOKEN=
# Necesario para verificar la firma HMAC de los webhooks entrantes.
WHATSAPP_APP_SECRET=

# -- Gmail (lectura de correos bancarios) -------------------------------------
# Google Cloud Console → APIs y servicios → Credenciales → OAuth 2.0.
# URI de redirección autorizado: {NEXT_PUBLIC_APP_URL}/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -- Tareas programadas -------------------------------------------------------
# Las rutas /api/cron/* exigen el header: Authorization: Bearer $CRON_SECRET
# Sin esta variable rechazan todas las peticiones (fallan cerradas a propósito).
# Genera una con: openssl rand -hex 32
CRON_SECRET=

# -- n8n (automatizaciones del usuario) ---------------------------------------
# Firma HMAC de las peticiones entrantes a /api/webhooks/n8n
N8N_WEBHOOK_SECRET=
